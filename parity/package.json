{
  "name": "mole-angular-parity",
  "private": true,
  "description": "Playwright parity suite: the same specs run against the baseline (4000) and upgraded (4200) Angular apps.",
  "scripts": {
    "test": "playwright test",
    "test:baseline": "playwright test --project=baseline",
    "test:upgraded": "playwright test --project=upgraded",
    "report": "node compose-report.js"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0"
  }
}
